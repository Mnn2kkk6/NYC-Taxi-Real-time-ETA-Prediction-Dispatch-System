# Host ports
FRONTEND_PORT=8081
BACKEND_PORT=8080
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Grafana local-development credentials. Change before exposing the machine.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-password

# PostgreSQL trip persistence
POSTGRES_DB=nyctaxi
POSTGRES_USER=nyctaxi
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgres://nyctaxi:change-this-local-password@postgres:5432/nyctaxi?sslmode=disable

# Go backend / ML service
ML_SERVICE_TIMEOUT_MS=2000
ML_SERVICE_RETRIES=3
PREDICTION_WORKERS=10
QUEUE_SIZE=100
DRIVER_COUNT=20

# Redis cache and rate limit
REDIS_POOL_SIZE=10
CACHE_TTL_SECONDS=600
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_WINDOW_SECONDS=60

# Optional simulator profile; folder must contain train.csv.
SIMULATOR_DATA_DIR=./ml-service/data
SIMULATOR_SPEED=50
SIMULATOR_LIMIT=500
SIMULATOR_WORKERS=20
