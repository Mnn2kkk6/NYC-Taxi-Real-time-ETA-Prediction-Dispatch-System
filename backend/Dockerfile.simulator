# Build the existing historical-trip replay tool.
FROM golang:1.24-alpine AS build

WORKDIR /src
COPY go.mod ./
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/simulator ./simulator/cmd/simulator

FROM alpine:3.21

RUN apk add --no-cache ca-certificates tzdata \
    && addgroup -S appgroup \
    && adduser -S -D -H -u 10001 -G appgroup appuser

COPY --from=build /out/simulator /usr/local/bin/simulator

USER appuser
ENTRYPOINT ["/usr/local/bin/simulator"]
